# ============================
# AgriSpectralSynth .gitignore
# ============================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Entornos virtuales
.venv/
venv/
env/
ENV/

# Distribución
build/
dist/
*.egg-info/
.eggs/

# IDEs
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Temporales
*.tmp
*.temp
*.bak
*.swp

# Cachés
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Cobertura
.coverage
htmlcov/

# Datos: imágenes de entrada y salidas generadas (pesan GB, no van a git).
# Las muestras para mostrar en GitHub van en assets/samples/
data/
output/
outputs/
results/
runs/
exports/
datasets/milliontrees/
datasets/generated/
datasets/tmp/

# Pesos de modelos (DeepForest: models/deepforest/NEON.pt)
models/
*.pt
*.pth
*.onnx
*.engine

# TensorBoard
events.out.tfevents.*

# Auxiliares de raster
*.aux.xml
*.ovr

# QGIS
*.qgz~
*.qgs~

# Variables de entorno
.env
.env.*

# Configuración local
config.local.py
configs/local*.yaml
